Checks:
  - bugprone-*
  - -bugprone-easily-swappable-parameters
  # Most cert-* checks are aliases of checks enabled elsewhere, and each enabled name runs the check again.
  # Only the ones that have no other name are listed. cert-err33-c is bugprone-unused-return-value with a
  # different list of functions (C library calls), so it adds coverage.
  - cert-dcl50-cpp
  - cert-env33-c
  - cert-err33-c
  - cert-err34-c
  - cert-err52-cpp
  - cert-err60-cpp
  - cert-flp30-c
  - cert-mem57-cpp
  - cert-msc50-cpp
  - cert-msc51-cpp
  - cert-oop57-cpp
  - cert-oop58-cpp
  - clang-analyzer-*
  - -clang-analyzer-core.StackAddressEscape # False positive in ArduinoJson's JsonDocument move constructor
  - -clang-analyzer-cplusplus.NewDeleteLeaks # False positives from ArduinoJson placement new and std::function internals
  - -clang-analyzer-security.ArrayBound # False positive in ArduinoJson's parseNumber
  - concurrency-*
  - cppcoreguidelines-*
  - -cppcoreguidelines-avoid-c-arrays
  - -cppcoreguidelines-avoid-const-or-ref-data-members
  - -cppcoreguidelines-avoid-magic-numbers
  - -cppcoreguidelines-init-variables
  - -cppcoreguidelines-macro-usage
  - -cppcoreguidelines-non-private-member-variables-in-classes
  - -cppcoreguidelines-owning-memory
  - -cppcoreguidelines-pro-bounds-array-to-pointer-decay
  - -cppcoreguidelines-pro-bounds-constant-array-index
  - -cppcoreguidelines-pro-bounds-pointer-arithmetic
  - -cppcoreguidelines-pro-type-reinterpret-cast
  - -cppcoreguidelines-pro-type-union-access
  - -cppcoreguidelines-pro-type-vararg
  - -cppcoreguidelines-special-member-functions
  # Aliases of misc-*, modernize-*, bugprone-* and performance-* checks enabled above and below
  - -cppcoreguidelines-c-copy-assignment-signature
  - -cppcoreguidelines-explicit-virtual-functions
  - -cppcoreguidelines-macro-to-enum
  - -cppcoreguidelines-narrowing-conversions
  - -cppcoreguidelines-noexcept-destructor
  - -cppcoreguidelines-noexcept-move-operations
  - -cppcoreguidelines-noexcept-swap
  - -cppcoreguidelines-use-default-member-init
  # We don't use coroutines
  - -cppcoreguidelines-avoid-capturing-lambda-coroutines
  - -cppcoreguidelines-avoid-reference-coroutine-parameters
  - -cppcoreguidelines-no-suspend-with-lock
  - google-*
  - -google-build-using-namespace
  - -google-explicit-constructor
  - -google-global-names-in-headers
  - -google-objc-*
  - -google-readability-todo
  # Aliases of readability-* and llvm-* checks enabled below
  - -google-readability-braces-around-statements
  - -google-readability-function-size
  - -google-readability-namespace-comments
  # We use Catch2, not GoogleTest
  - -google-readability-avoid-underscore-in-googletest-name
  - -google-upgrade-googletest-case
  # Most hicpp-* checks are aliases of checks enabled elsewhere; only the ones that have no other name are listed
  - hicpp-exception-baseclass
  - hicpp-multiway-paths-covered
  - hicpp-no-assembler
  # The rest of llvm-* is either an alias, about LLVM's own APIs, or conflicts with clang-format (include order)
  - llvm-namespace-comment
  - llvm-prefer-static-over-anonymous-namespace
  - misc-*
  - -misc-const-correctness
  - -misc-coroutine-hostile-raii # We don't use coroutines
  - -misc-definitions-in-headers
  - -misc-non-private-member-variables-in-classes
  - -misc-use-anonymous-namespace # Contradicts llvm-prefer-static-over-anonymous-namespace
  - -misc-unused-parameters # Unfortunately this doesn't understand the _name convention
  - modernize-*
  - -modernize-avoid-c-arrays
  - -modernize-pass-by-value
  - -modernize-use-nodiscard
  - -modernize-use-std-print
  - -modernize-use-trailing-return-type
  # No auto_ptr or iostreams to modernize
  - -modernize-deprecated-ios-base-aliases
  - -modernize-replace-auto-ptr
  - performance-*
  - portability-*
  - -portability-avoid-pragma-once
  - -portability-std-allocator-const # libstdc++, used by our GCC build, rejects such containers already
  - -portability-template-virtual-member-function
  - readability-*
  - -readability-identifier-length
  - -readability-magic-numbers
  - -readability-use-anyofallof

CheckOptions:
  readability-function-cognitive-complexity.Threshold: 500
  cppcoreguidelines-avoid-do-while.IgnoreMacros: true
  # Carried over from its alias cert-oop54-cpp, which we no longer run: warn on every
  # copy assignment without a self-assignment check, not only ones with pointer members.
  bugprone-unhandled-self-assignment.WarnOnlyIfThisHasSuspiciousField: false
  # misc-include-cleaner suggests internal headers (ArduinoJson/Document/JsonDocument.hpp,
  # bits/chrono.h, etc.) instead of the public umbrella headers (ArduinoJson.h, <chrono>)
  # because neither library carries IWYU export pragmas. Ignore the internal trees.
  misc-include-cleaner.IgnoreHeaders: "ArduinoJson/.*|bits/.*"

# Used by clangd (VS Code). The CLI overrides this with --header-filter="$(pwd)/(main|components)/"
# to get an absolute path, which avoids matching ESP-IDF's components/ tree.
HeaderFilterRegex: "/(main|components)/"

WarningsAsErrors: "*"
